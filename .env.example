# Optional: Ompanel Connect source builds
# Ompanel runs no Clerk instance or relay of its own yet, so these ship empty and
# source builds have cloud features off. Do not fill them with upstream T3 Code's
# identifiers: that signs users in to upstream's Clerk and sends their tokens to
# upstream's relay. Set them only to a Clerk instance and relay you run.
# Do not add server-side secrets to this file.

# Clerk instance: from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# OMPANEL_CLERK_PUBLISHABLE_KEY=
# OMPANEL_CLERK_JWT_TEMPLATE=
# OMPANEL_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in OMPANEL_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# OMPANEL_APPLE_TEAM_ID=ABC1234567
# OMPANEL_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# OMPANEL_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com
# Mobile passkeys: the Clerk Frontend API domain the iOS app is entitled to. Unset, the
# app declares no associated domains and passkeys are off.
# OMPANEL_MOBILE_PASSKEY_RP_DOMAIN=clerk.example.com

# Relay origin, for example https://relay.example.com. `infra/relay` deploys of your
# own relay update it automatically.
# OMPANEL_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow. Unset by
# default, which keeps CLI cloud commands off; set it only to a hosted app you run.
# OMPANEL_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# OMPANEL_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# OMPANEL_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# OMPANEL_MOBILE_OTLP_TRACES_TOKEN=xaat-...
